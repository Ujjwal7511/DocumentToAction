# Document-to-Action — Environment Configuration
# MongoDB is the ONLY persistence backend. SQLite/SQLAlchemy have been removed.

# --- Required: MongoDB Atlas connection string ---
# Create a free cluster at https://www.mongodb.com/atlas:
#   1. Build a Database -> M0 Free (Shared) cluster -> Create
#   2. Database Access -> Add New Database User -> create a username/password
#      (use a strong password and keep it safe)
#   3. Network Access -> Add IP Address -> Allow Access from Anywhere (0.0.0.0/0)
#      or add your specific IP for tighter security
#   4. Connect -> Drivers -> copy the connection string and paste it below.
#
# The connection string must include your database user's credentials:
#   mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority"

# --- MongoDB database name (optional, defaults to "document_to_action") ---
# The app reads this value; if unset it falls back to MONGODB_DB, then
# "document_to_action".
MONGODB_DB_NAME=DocumentToAction

# --- Optional legacy alias (still supported for backwards compatibility) ---
# MONGODB_DB=DocumentToAction

# --- Optional: Google Gemini (full LLM quality; heuristic mode works without it) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Optional: OpenAI-compatible failover (Groq / OpenRouter) ---
# LLM_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=your_key_here
# OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

# --- Optional: LLM retry tuning ---
# LLM_MAX_RETRIES=3
# LLM_RETRY_BACKOFF=1.5

